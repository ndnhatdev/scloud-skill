{
  "name": "ai-skills-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready monorepo tối giản để quản lý và đóng gói AI Skills dạng single-file tool.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "audit:skill": "ts-node scripts/audit-skill.ts",
    "audit:rust-master": "ts-node scripts/audit-skill.ts rust-master",
    "audit:rust-ecosystem": "ts-node scripts/audit-skill.ts rust-ecosystem",
    "audit:rust-platforms": "ts-node scripts/audit-skill.ts rust-platforms",
    "pack": "ts-node scripts/packager.ts",
    "package:agent-skill": "python3 .agents/skills/skill-creator/scripts/package_skill.py",
    "typecheck": "tsc --noEmit",
    "validate:agent-skill": "python3 .agents/skills/skill-creator/scripts/quick_validate.py"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "tar": "^7.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "esbuild": "^0.25.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  }
}
